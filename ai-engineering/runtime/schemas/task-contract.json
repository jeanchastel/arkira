{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "acceptance",
    "non_goals",
    "scope",
    "verification",
    "ui",
    "harness",
    "skills",
    "dispatch"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [2]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "protected", "adopted"],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adopted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "focused_check"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["quick", "normal", "elevated", "high-assurance"]
        },
        "focused_check": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "dev_command", "review_url"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "inspect", "local-review", "browser"]
        },
        "dev_command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_url": {
          "type": "string"
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "version", "channel", "content_digest"],
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
