{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arkira additive risk paths",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "elevated_paths"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "elevated_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "glob"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "glob": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
