{
  "id": "codex-cli",
  "display_name": "Codex CLI",
  "capabilities": [
    "repo_reading",
    "code_editing",
    "test_execution",
    "structured_reviewing"
  ],
  "cli_binary": "codex",
  "default_model": "gpt-6-astra",
  "model_pattern": "^(gpt-|o[0-9]|codex)",
  "context_file": "CODEX.md",
  "model_aliases": {},
  "supported_efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"],
  "auth_check_command": {
    "executable": "codex",
    "args": ["login", "status"]
  },
  "authentication_instructions": "Run codex login and complete the provider login flow.",
  "invocation": {
    "repo_reading": {
      "executable": "codex",
      "args": ["exec", "--sandbox", "read-only", "-C", "{repo_root}", "-m", "{model}", "-c", "model_reasoning_effort=\"low\"", "--ephemeral", "-"],
      "input": "stdin",
      "output": "text",
      "schema_enforced": false
    },
    "code_editing": {
      "executable": "codex",
      "args": ["exec", "--sandbox", "workspace-write", "-C", "{repo_root}", "-m", "{model}", "-c", "model_reasoning_effort=\"medium\"", "--ephemeral", "-"],
      "input": "stdin",
      "output": "text",
      "schema_enforced": false
    },
    "test_execution": {
      "executable": "codex",
      "args": ["exec", "--sandbox", "workspace-write", "--approve-for-me", "-C", "{repo_root}", "-m", "{model}", "-c", "model_reasoning_effort=\"low\"", "--ephemeral", "-"],
      "input": "stdin",
      "output": "text",
      "schema_enforced": false
    },
    "structured_reviewing": {
      "executable": "codex",
      "args": ["exec", "--sandbox", "read-only", "-C", "{repo_root}", "-m", "{model}", "-c", "model_reasoning_effort=\"high\"", "-c", "project_doc_max_bytes=0", "--output-schema", "{schema_file}", "-o", "{output_file}", "--ephemeral", "-"],
      "input": "stdin",
      "output": "json",
      "schema_enforced": true
    }
  }
}
